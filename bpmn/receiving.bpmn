<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    id="ReceivingDefinitions"
    targetNamespace="http://cold-chain.example/bpmn">

  <bpmn:process
      id="StockReceiving"
      name="P3 Receiving and Stock Admission"
      isExecutable="true">

    <bpmn:startEvent id="ReceivingStarted" name="Receiving started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="RecordReceipt" name="Record goods receipt">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="p3-record-receipt" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="InspectGoods" name="Inspect received goods">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="p3-inspect-goods" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway
        id="AdmissionDecision"
        name="Can stock be admitted?"
        default="Flow_5">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="AdmitStock" name="Admit stock to inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="p3-admit-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="StockAdmitted" name="Stock admitted">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="StockNotAdmitted" name="Stock not admitted">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1"
        sourceRef="ReceivingStarted" targetRef="RecordReceipt" />

    <bpmn:sequenceFlow id="Flow_2"
        sourceRef="RecordReceipt" targetRef="InspectGoods" />

    <bpmn:sequenceFlow id="Flow_3"
        sourceRef="InspectGoods" targetRef="AdmissionDecision" />

    <bpmn:sequenceFlow id="Flow_4"
        name="Admission allowed"
        sourceRef="AdmissionDecision" targetRef="AdmitStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
        = admissionAllowed = true
      </bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_5"
        name="Admission blocked"
        sourceRef="AdmissionDecision" targetRef="StockNotAdmitted" />

    <bpmn:sequenceFlow id="Flow_6"
        sourceRef="AdmitStock" targetRef="StockAdmitted" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Receiving">
    <bpmndi:BPMNPlane
        id="BPMNPlane_Receiving"
        bpmnElement="StockReceiving">

      <bpmndi:BPMNShape id="Shape_ReceivingStarted" bpmnElement="ReceivingStarted">
        <dc:Bounds x="100" y="180" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_RecordReceipt" bpmnElement="RecordReceipt">
        <dc:Bounds x="190" y="158" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_InspectGoods" bpmnElement="InspectGoods">
        <dc:Bounds x="370" y="158" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_AdmissionDecision" bpmnElement="AdmissionDecision" isMarkerVisible="true">
        <dc:Bounds x="550" y="173" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_AdmitStock" bpmnElement="AdmitStock">
        <dc:Bounds x="680" y="90" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StockAdmitted" bpmnElement="StockAdmitted">
        <dc:Bounds x="880" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_StockNotAdmitted" bpmnElement="StockNotAdmitted">
        <dc:Bounds x="680" y="270" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="136" y="198" />
        <di:waypoint x="190" y="198" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="310" y="198" />
        <di:waypoint x="370" y="198" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="490" y="198" />
        <di:waypoint x="550" y="198" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="575" y="173" />
        <di:waypoint x="575" y="130" />
        <di:waypoint x="680" y="130" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="575" y="223" />
        <di:waypoint x="575" y="288" />
        <di:waypoint x="680" y="288" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="800" y="130" />
        <di:waypoint x="880" y="130" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
