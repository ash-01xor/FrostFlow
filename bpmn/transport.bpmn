<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="ColdChainDefinitions" targetNamespace="http://cold-chain.example/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="ShipmentTransport" name="P2 Transport handoff" isExecutable="true">
    <bpmn:startEvent id="DispatchReceived" name="Shipment dispatched">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="DispatchReceivedDefinition" messageRef="Message_ShipmentDispatched" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="StartTransport" name="Register transport handoff">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="p2-start-transport" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="StartJourney" name="Start journey">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="p2-start-journey" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="JourneyMerge" name="Resume">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_3m</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="JourneyEvents" name="Journey events">
      <bpmn:incoming>Flow_3m</bpmn:incoming>
      <bpmn:outgoing>Flow_3a</bpmn:outgoing>
      <bpmn:outgoing>Flow_3b</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="WaitForShipmentArrived" name="Wait for shipment arrival">
      <bpmn:incoming>Flow_3a</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="WaitForShipmentArrivedDefinition" messageRef="Message_ShipmentArrived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="WaitForDeliveryRisk" name="Wait for delivery risk">
      <bpmn:incoming>Flow_3b</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="WaitForDeliveryRiskDefinition" messageRef="Message_DeliveryRiskDetected" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="RecordDeliveryRisk" name="Record delivery risk">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="p2-record-delivery-risk" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="DecisionOrArrival" name="Wait for decision or arrival">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_9a</bpmn:outgoing>
      <bpmn:outgoing>Flow_9b</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="WaitForArrivalDuringDecision" name="Arrived before decision">
      <bpmn:incoming>Flow_9b</bpmn:incoming>
      <bpmn:outgoing>Flow_9c</bpmn:outgoing>
      <bpmn:messageEventDefinition id="WaitForArrivalDuringDecisionDefinition" messageRef="Message_ShipmentArrived" />
    </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="ArrivalMerge" name="Merge arrivals">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_9c</bpmn:incoming>
      <bpmn:outgoing>Flow_4m</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="WaitForDispatcherDecision" name="Wait for dispatcher decision">
      <bpmn:incoming>Flow_9a</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="WaitForDispatcherDecisionDefinition" messageRef="Message_DispatcherDecisionRecorded" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ApplyDispatcherDecision" name="Apply dispatcher decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="p2-apply-dispatcher-decision" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="RecordArrival" name="Record arrival">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="p2-record-arrival" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4m</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="WaitForReceiptAcknowledged" name="Wait for receipt acknowledgement">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="WaitForReceiptAcknowledgedDefinition" messageRef="Message_ReceiptAcknowledged" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ReleaseVehicle" name="Release vehicle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="p2-release-vehicle" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="TransportCompleted" name="Transport completed">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="DispatchReceived" targetRef="StartTransport" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="StartTransport" targetRef="StartJourney" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="StartJourney" targetRef="JourneyMerge" />
    <bpmn:sequenceFlow id="Flow_3m" sourceRef="JourneyMerge" targetRef="JourneyEvents" />
    <bpmn:sequenceFlow id="Flow_3a" sourceRef="JourneyEvents" targetRef="WaitForShipmentArrived" />
    <bpmn:sequenceFlow id="Flow_3b" sourceRef="JourneyEvents" targetRef="WaitForDeliveryRisk" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="WaitForDeliveryRisk" targetRef="RecordDeliveryRisk" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="RecordDeliveryRisk" targetRef="DecisionOrArrival" />
    <bpmn:sequenceFlow id="Flow_9a" sourceRef="DecisionOrArrival" targetRef="WaitForDispatcherDecision" />
    <bpmn:sequenceFlow id="Flow_9b" sourceRef="DecisionOrArrival" targetRef="WaitForArrivalDuringDecision" />
    <bpmn:sequenceFlow id="Flow_9c" sourceRef="WaitForArrivalDuringDecision" targetRef="ArrivalMerge" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="WaitForDispatcherDecision" targetRef="ApplyDispatcherDecision" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="ApplyDispatcherDecision" targetRef="JourneyMerge" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="WaitForShipmentArrived" targetRef="ArrivalMerge" />
    <bpmn:sequenceFlow id="Flow_4m" sourceRef="ArrivalMerge" targetRef="RecordArrival" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="RecordArrival" targetRef="WaitForReceiptAcknowledged" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="WaitForReceiptAcknowledged" targetRef="ReleaseVehicle" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="ReleaseVehicle" targetRef="TransportCompleted" />
  </bpmn:process>
  <bpmn:message id="Message_ShipmentDispatched" name="ShipmentDispatched" />
  <bpmn:message id="Message_ShipmentArrived" name="ShipmentArrived">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_ReceiptAcknowledged" name="ReceiptAcknowledged">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_DeliveryRiskDetected" name="DeliveryRiskDetected">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_DispatcherDecisionRecorded" name="DispatcherDecisionRecorded">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=shipmentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="ShipmentTransport">
      <bpmndi:BPMNShape id="DispatchReceived_di" bpmnElement="DispatchReceived">
        <dc:Bounds x="120" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="92" y="173" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartTransport_di" bpmnElement="StartTransport">
        <dc:Bounds x="220" y="110" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartJourney_di" bpmnElement="StartJourney">
        <dc:Bounds x="400" y="110" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="JourneyMerge_di" bpmnElement="JourneyMerge">
        <dc:Bounds x="530" y="130" width="40" height="40" />
        <bpmndi:BPMNLabel><dc:Bounds x="510" y="175" width="55" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="JourneyEvents_di" bpmnElement="JourneyEvents">
        <dc:Bounds x="600" y="130" width="40" height="40" />
        <bpmndi:BPMNLabel><dc:Bounds x="570" y="175" width="100" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WaitForShipmentArrived_di" bpmnElement="WaitForShipmentArrived">
        <dc:Bounds x="700" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="666" y="174" width="104" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ArrivalMerge_di" bpmnElement="ArrivalMerge">
        <dc:Bounds x="810" y="130" width="40" height="40" />
        <bpmndi:BPMNLabel><dc:Bounds x="780" y="175" width="100" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WaitForDeliveryRisk_di" bpmnElement="WaitForDeliveryRisk">
        <dc:Bounds x="602" y="300" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="568" y="340" width="110" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordDeliveryRisk_di" bpmnElement="RecordDeliveryRisk">
        <dc:Bounds x="700" y="280" width="110" height="80" /><bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WaitForDispatcherDecision_di" bpmnElement="WaitForDispatcherDecision">
        <dc:Bounds x="930" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="895" y="342" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DecisionOrArrival_di" bpmnElement="DecisionOrArrival">
        <dc:Bounds x="850" y="300" width="40" height="40" />
        <bpmndi:BPMNLabel><dc:Bounds x="795" y="248" width="145" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WaitForArrivalDuringDecision_di" bpmnElement="WaitForArrivalDuringDecision">
        <dc:Bounds x="852" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="890" y="202" width="100" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApplyDispatcherDecision_di" bpmnElement="ApplyDispatcherDecision">
        <dc:Bounds x="1040" y="280" width="120" height="80" /><bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordArrival_di" bpmnElement="RecordArrival">
        <dc:Bounds x="900" y="110" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WaitForReceiptAcknowledged_di" bpmnElement="WaitForReceiptAcknowledged">
        <dc:Bounds x="1040" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1002" y="174" width="112" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReleaseVehicle_di" bpmnElement="ReleaseVehicle">
        <dc:Bounds x="1130" y="110" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TransportCompleted_di" bpmnElement="TransportCompleted">
        <dc:Bounds x="1300" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1268" y="174" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="156" y="150" />
        <di:waypoint x="220" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="320" y="150" />
        <di:waypoint x="400" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="500" y="150" />
        <di:waypoint x="530" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3m_di" bpmnElement="Flow_3m"><di:waypoint x="570" y="150" /><di:waypoint x="600" y="150" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3a_di" bpmnElement="Flow_3a"><di:waypoint x="640" y="150" /><di:waypoint x="700" y="150" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3b_di" bpmnElement="Flow_3b"><di:waypoint x="620" y="170" /><di:waypoint x="620" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="638" y="318" /><di:waypoint x="700" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="810" y="320" /><di:waypoint x="850" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9a_di" bpmnElement="Flow_9a"><di:waypoint x="890" y="320" /><di:waypoint x="930" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9b_di" bpmnElement="Flow_9b"><di:waypoint x="870" y="300" /><di:waypoint x="870" y="236" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9c_di" bpmnElement="Flow_9c"><di:waypoint x="852" y="218" /><di:waypoint x="830" y="218" /><di:waypoint x="830" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="966" y="320" /><di:waypoint x="1040" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1100" y="360" /><di:waypoint x="1100" y="420" /><di:waypoint x="550" y="420" /><di:waypoint x="550" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="736" y="150" />
        <di:waypoint x="810" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4m_di" bpmnElement="Flow_4m">
        <di:waypoint x="850" y="150" />
        <di:waypoint x="900" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1000" y="150" />
        <di:waypoint x="1040" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1076" y="150" />
        <di:waypoint x="1130" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1230" y="150" />
        <di:waypoint x="1300" y="150" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
